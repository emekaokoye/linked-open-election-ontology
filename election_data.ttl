# 2020 U.S. Presidential Election
:Election2020USA a :Election ;
    schema:name "2020 U.S. Presidential Election"@en ;
    :hasVotingSystem :FirstPastThePost ;
    :totalVotes 159000000 ;
    :registeredVoters 239000000 ;
    :countingCompletedDate "2020-11-06T12:00:00Z"^^xsd:dateTime ;
    :resultAnnouncedDate "2020-11-07T12:00:00Z"^^xsd:dateTime ;
    :visualization <http://example.com/viz/2020usa-map> .

:JoeBidenPerson a foaf:Person ;
    foaf:name "Joe Biden"@en .

:JoeBidenCandidacy a :Candidacy ;
    :name "Joe Biden"@en ;
    :candidacyAgent :JoeBidenPerson ;
    :candidacyElection :Election2020USA ;
    :isOfPoliticalParty :DemocraticParty ;
    :totalVotes 81268924 ;
    :isWinner true ;
    :voteOutcome :For .

:DonaldTrumpPerson a foaf:Person ;
    foaf:name "Donald Trump"@en .

:DonaldTrumpCandidacy a :Candidacy ;
    :name "Donald Trump"@en ;
    :candidacyAgent :DonaldTrumpPerson ;
    :candidacyElection :Election2020USA ;
    :isOfPoliticalParty :RepublicanParty ;
    :totalVotes 74216154 ;
    :isWinner false ;
    :voteOutcome :Against .

:DemocraticParty a :PoliticalParty ;
    schema:name "Democratic Party"@en .

:RepublicanParty a :PoliticalParty ;
    schema:name "Republican Party"@en .

:PennsylvaniaPoll2020 a :PollingLocation ;
    schema:name "Pennsylvania State Poll"@en ;
    :hasElection :Election2020USA ;
    :latitude "40.7608"^^xsd:decimal ;
    :longitude "-77.0369"^^xsd:decimal ;
    :totalVotes 6900000 ;
    :registeredVoters 9100000 ;
    :countingCompletedDate "2020-11-06T12:00:00Z"^^xsd:dateTime .

